[Unit]
Description = Fuel Counter for HomeField 2026
After       = network-online.target hf26-hublights.service
Wants       = network-online.target

[Service]
User             = root
WorkingDirectory = /opt/Home-Field-2026/
ExecStart        = /usr/bin/python3 /opt/Home-Field-2026/fuel-sensors.py
Restart          = on-failure
RestartSec       = 5

[Install]
WantedBy = HomeField26.target